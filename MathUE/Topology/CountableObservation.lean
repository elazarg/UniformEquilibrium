import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
import Mathlib.Topology.Bases

/-!
# Topologies generated by countably many discrete observations

A countable family of countable-valued observations generates a second-countable
topology on an arbitrary path type.  Its single-observation cylinders are
clopen, and the sigma algebra generated by those cylinders is the Borel sigma
algebra.  No probability law or transition structure is used here.
-/

namespace Math.CountableObservation

open Set TopologicalSpace

universe u v

variable {Path : Type u} (Prefix : ℕ → Type v)
  (observe : (n : ℕ) → Path → Prefix n)

/-- Paths having one prescribed finite observation. -/
def cylinder (n : ℕ) (value : Prefix n) : Set Path :=
  {path | observe n path = value}

/-- The family of all single-observation cylinders. -/
def cylinders : Set (Set Path) :=
  {set | ∃ n value, set = cylinder Prefix observe n value}

/-- The topology generated by finite-observation cylinders. -/
abbrev topology : TopologicalSpace Path :=
  TopologicalSpace.generateFrom (cylinders Prefix observe)

/-- The sigma algebra generated by finite-observation cylinders. -/
abbrev measurableSpace : MeasurableSpace Path :=
  MeasurableSpace.generateFrom (cylinders Prefix observe)

theorem cylinder_mem_cylinders (n : ℕ) (value : Prefix n) :
    cylinder Prefix observe n value ∈ cylinders Prefix observe :=
  ⟨n, value, rfl⟩

theorem isOpen_cylinder (n : ℕ) (value : Prefix n) :
    @IsOpen Path (topology Prefix observe) (cylinder Prefix observe n value) :=
  isOpen_generateFrom_of_mem (cylinder_mem_cylinders Prefix observe n value)

theorem measurableSet_cylinder (n : ℕ) (value : Prefix n) :
    @MeasurableSet Path (measurableSpace Prefix observe)
      (cylinder Prefix observe n value) :=
  MeasurableSpace.measurableSet_generateFrom
    (cylinder_mem_cylinders Prefix observe n value)

theorem isClosed_cylinder (n : ℕ) (value : Prefix n) :
    @IsClosed Path (topology Prefix observe) (cylinder Prefix observe n value) := by
  letI : TopologicalSpace Path := topology Prefix observe
  apply isOpen_compl_iff.mp
  have hcomplement :
      (cylinder Prefix observe n value)ᶜ =
        ⋃ other : {other : Prefix n // other ≠ value},
          cylinder Prefix observe n other := by
    ext path
    simp only [mem_compl_iff, mem_setOf_eq, mem_iUnion, cylinder]
    constructor
    · intro hne
      exact ⟨⟨observe n path, hne⟩, rfl⟩
    · rintro ⟨other, heq⟩
      exact fun hvalue ↦ other.property (heq.symm.trans hvalue)
  rw [hcomplement]
  exact isOpen_iUnion fun other ↦
    isOpen_cylinder Prefix observe n other

theorem cylinders_countable [∀ n, Countable (Prefix n)] :
    (cylinders Prefix observe).Countable := by
  have hdescription :
      cylinders Prefix observe =
        ⋃ n : ℕ, range (cylinder Prefix observe n) := by
    ext set
    simp only [cylinders, mem_setOf_eq, mem_iUnion, mem_range]
    constructor
    · rintro ⟨n, value, rfl⟩
      exact ⟨n, value, rfl⟩
    · rintro ⟨n, value, rfl⟩
      exact ⟨n, value, rfl⟩
  rw [hdescription]
  exact countable_iUnion fun _ ↦ countable_range _

/-- A countable observation topology is second countable. -/
abbrev secondCountableTopology [∀ n, Countable (Prefix n)] :
    @SecondCountableTopology Path (topology Prefix observe) :=
  SecondCountableTopology.mk' (cylinders_countable Prefix observe)

/-- The Borel sigma algebra of a countable observation topology is exactly the
sigma algebra generated by its cylinders. -/
theorem borel_eq_measurableSpace [∀ n, Countable (Prefix n)] :
    @borel Path (topology Prefix observe) = measurableSpace Prefix observe := by
  letI : TopologicalSpace Path := topology Prefix observe
  letI : SecondCountableTopology Path :=
    secondCountableTopology Prefix observe
  exact borel_eq_generateFrom_of_subbasis rfl

end Math.CountableObservation
