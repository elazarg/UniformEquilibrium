/-- The open problem at the end of Section 2. -/
def HigherPlayerSimpleConnectednessQuestion : Prop :=
  ∀ (ι : Type) [Fintype ι] [DecidableEq ι],
    2 < Fintype.card ι →
    ∀ (G : StageGame ι) (n : ℕ), 0 < n →
