import UniformEquilibrium.Diagnostics.Quitting.ScreenedRootPolynomial
import MathUE.LinearAlgebra.RectangularCofactorHomogeneous

/-! # The constructed screened-root factors are homogeneous of degree six

Homogeneity includes a potentially zero polynomial. The literal bounded
reward witnesses in the following module provide nonvanishing and therefore
the exact total degrees. No density conclusion is claimed here.
-/

namespace GameTheory

open scoped BigOperators

theorem screenedRootCornerPolynomial_isHomogeneous
    (pair : Fin 6) (labels : Fin 2 → Bool) (index : Fin 4) (a b : Bool) :
    (screenedRootCornerPolynomial pair labels index a b).IsHomogeneous 1 := by
  unfold screenedRootCornerPolynomial
  exact (MvPolynomial.isHomogeneous_X ℤ _).sub (MvPolynomial.isHomogeneous_X ℤ _)

theorem screenedRootCoefficientPolynomial_isHomogeneous
    (pair : Fin 6) (labels : Fin 2 → Bool) (index column : Fin 4) :
    (screenedRootCoefficientPolynomial pair labels index column).IsHomogeneous 1 := by
  have h := screenedRootCornerPolynomial_isHomogeneous pair labels index
  fin_cases column
  · exact h false false
  · exact (h true false).sub (h false false)
  · exact (h false true).sub (h false false)
  · exact (((h true true).sub (h true false)).sub (h false true)).add (h false false)

theorem screenedRootDifferencePolynomialMatrix_isHomogeneous
    (factor : ScreenedRootFactorIndex) (row : Fin 3) (column : Fin 4) :
    (screenedRootDifferencePolynomialMatrix factor row column).IsHomogeneous 1 :=
  (screenedRootCoefficientPolynomial_isHomogeneous factor.1 factor.2 row.succ column).sub
    (screenedRootCoefficientPolynomial_isHomogeneous factor.1 factor.2 0 column)

theorem screenedRootSignedMinorPolynomials_isHomogeneous
    (factor : ScreenedRootFactorIndex) (column : Fin 4) :
    (screenedRootSignedMinorPolynomials factor column).IsHomogeneous 3 := by
  exact Math.LinearAlgebra.isHomogeneous_signedMaximalMinors_fin_three
    (screenedRootDifferencePolynomialMatrix factor) 1
    (screenedRootDifferencePolynomialMatrix_isHomogeneous factor) column

theorem screenedRootFactorPolynomial_isHomogeneous (factor : ScreenedRootFactorIndex) :
    (screenedRootFactorPolynomial factor).IsHomogeneous 6 :=
  ((screenedRootSignedMinorPolynomials_isHomogeneous factor 0).mul
    (screenedRootSignedMinorPolynomials_isHomogeneous factor 3)).sub
      ((screenedRootSignedMinorPolynomials_isHomogeneous factor 1).mul
        (screenedRootSignedMinorPolynomials_isHomogeneous factor 2))

theorem screenedRootExclusionPolynomial_isHomogeneous :
    screenedRootExclusionPolynomial.IsHomogeneous 144 := by
  have h := MvPolynomial.IsHomogeneous.prod Finset.univ screenedRootFactorPolynomial
    (fun _ => 6) (fun factor _ => screenedRootFactorPolynomial_isHomogeneous factor)
  simpa only [screenedRootExclusionPolynomial, Finset.sum_const, Finset.card_univ,
    card_screenedRootFactorIndex, smul_eq_mul] using h

theorem screenedRootFactorPolynomial_totalDegree_le (factor : ScreenedRootFactorIndex) :
    (screenedRootFactorPolynomial factor).totalDegree ≤ 6 :=
  (screenedRootFactorPolynomial_isHomogeneous factor).totalDegree_le

theorem screenedRootExclusionPolynomial_totalDegree_le :
    screenedRootExclusionPolynomial.totalDegree ≤ 144 :=
  screenedRootExclusionPolynomial_isHomogeneous.totalDegree_le

end GameTheory
