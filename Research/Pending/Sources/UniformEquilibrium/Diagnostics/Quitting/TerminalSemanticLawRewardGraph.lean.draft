import MathUE.Topology.UniformLipschitzFiberClosure
import UniformEquilibrium.Diagnostics.Quitting.TerminalSemanticResetIncidenceReturn
import UniformEquilibrium.Quitting.Terminal.TerminalExploitabilityRewardRobustness
import Mathlib.Topology.MetricSpace.Pseudo.Pi

/-! # Closed actual joint semantic/law graph under changing rewards

Only the same executable profile is reevaluated. Its entire outcome law,
including Never, stays unchanged; all behavioral reply caps move uniformly.
No continuity of caps in a stopping-law topology is asserted.
-/

noncomputable section

namespace GameTheory

open Set

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- Reusing one actual profile across two reward tables preserves its whole law literally. -/
theorem quittingTerminalOutcomeMass_reward_independent
    (first second : {S : Finset ι // S.Nonempty} → Payoff ι)
    (profile : (quittingGame first).BehaviorProfile) :
    quittingTerminalOutcomeMass first profile = quittingTerminalOutcomeMass second profile := rfl

/-- The joint payoff/cap/law vector of any SAME actual profile is one-Lipschitz
in the actual reward table. Response caps retain the unrestricted reply space. -/
theorem lipschitzWith_actualTerminalSemanticLaw_reward
    (profile : (quittingGame (0 : {S : Finset ι // S.Nonempty} → Payoff ι)).BehaviorProfile) :
    LipschitzWith 1 (fun reward : {S : Finset ι // S.Nonempty} → Payoff ι =>
      (quittingTerminalSemanticPair reward profile,
        quittingTerminalOutcomeMass reward profile)) := by
  apply LipschitzWith.of_dist_le_mul
  intro first second
  have hclose : ∀ terminal player, |first terminal player - second terminal player| ≤
      dist first second := by
    intro terminal player
    rw [← Real.dist_eq]
    exact (dist_le_pi_dist (first terminal) (second terminal) player).trans
      (dist_le_pi_dist first second terminal)
  simp only [NNReal.coe_one, one_mul, Prod.dist_eq]
  apply max_le
  · apply max_le
    · apply (dist_pi_le_iff dist_nonneg).mpr
      intro who
      rw [Real.dist_eq]
      exact abs_quittingTerminalPayoff_sub_le_of_forall_abs_sub_le
        first second profile who dist_nonneg hclose
    · apply (dist_pi_le_iff dist_nonneg).mpr
      intro who
      rw [Real.dist_eq]
      exact abs_quittingContinuationBestResponseValue_sub_le_of_reward_close
        first second profile who dist_nonneg hclose
  · rw [quittingTerminalOutcomeMass_reward_independent first second profile, dist_self]
    exact dist_nonneg

/-- The graph of the actual joint carrier is closed as rewards vary. -/
theorem isClosed_terminalSemanticLawCarrier_reward_graph :
    IsClosed {point : ({S : Finset ι // S.Nonempty} → Payoff ι) ×
      QuittingTerminalSemanticLawPoint ι |
      point.2 ∈ quittingTerminalSemanticLawCarrier point.1} := by
  exact Math.isClosed_graph_closure_range_of_uniform_lipschitz
    (fun reward
      (profile : (quittingGame (0 : {S : Finset ι // S.Nonempty} → Payoff ι)).BehaviorProfile) =>
      (quittingTerminalSemanticPair reward profile, quittingTerminalOutcomeMass reward profile))
    1 lipschitzWith_actualTerminalSemanticLaw_reward

end GameTheory
