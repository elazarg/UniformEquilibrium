+/-- A raw four-player no-UE table produces ONE literal source, and every actual
+all-but-one-sure minimum at that source has opposed strict core reversals. -/
+theorem exists_membershipStretch_source_opposedReversals_of_no_uniformPayoff_finFour
+    (reward : {S : Finset (Fin 4) // S.Nonempty} → Payoff (Fin 4))
+    (hnoUE : ¬ ∃ payoff : Payoff (Fin 4),
+      (quittingGame reward).IsUniformEquilibriumPayoff none payoff) :
+    ∃ (original : {S : Finset (Fin 4) // S.Nonempty} → Payoff (Fin 4))
+      (alpha : ℝ) (singletons : Fin 4 → ℝ)
+      (coordinates : QuittingFreeRewardCoordinate (Fin 4) → ℝ),
+      (∀ terminal who, |original terminal who| ≤ 1) ∧
+      0 < quittingTerminalExploitabilityInf original ∧
+      quittingTerminalExploitabilityInf original ≤ 1 ∧
+      (∀ candidate : {S : Finset (Fin 4) // S.Nonempty} → Payoff (Fin 4),
+        (∀ terminal who, |candidate terminal who| ≤ 1) →
+          quittingTerminalExploitabilityInf candidate ≤
+            quittingTerminalExploitabilityInf original) ∧
+      0 < alpha ∧ alpha < quittingTerminalExploitabilityInf original / 8 ∧
+      (∀ coordinate, coordinates coordinate =
+        quittingMembershipStretchedReward original alpha coordinate.1.1 coordinate.1.2) ∧
+      (∀ who, |singletons who| ≤ 1) ∧
+      (∀ terminal who, |quittingOwnSingletonReward singletons coordinates terminal who| ≤ 1) ∧
+      QuittingAgreesWithMembershipStretch original
+        (quittingOwnSingletonReward singletons coordinates) alpha ∧
+      (∀ candidate : Fin 4 → ℝ, (∀ who, |candidate who| ≤ 1) →
+        quittingTerminalExploitabilityInf (quittingOwnSingletonReward candidate coordinates) ≤
+          quittingTerminalExploitabilityInf
+            (quittingOwnSingletonReward singletons coordinates)) ∧
+      quittingTerminalExploitabilityInf original / 2 <
+        quittingTerminalExploitabilityInf (quittingOwnSingletonReward singletons coordinates) ∧
+      quittingTerminalExploitabilityInf (quittingOwnSingletonReward singletons coordinates) ≤
+        quittingTerminalExploitabilityInf original ∧
+      alpha < quittingTerminalExploitabilityInf
+        (quittingOwnSingletonReward singletons coordinates) / 4 ∧
+      ∀ (root : Fin 4 → PMF Bool) (optional : Fin 4),
+        (∀ who, who ≠ optional → (root who true).toReal = 1) →
+        quittingTerminalExploitability (quittingOwnSingletonReward singletons coordinates)
+            (quittingOneDateThenNeverProfile
+              (quittingOwnSingletonReward singletons coordinates) root) =
+          quittingTerminalExploitabilityInf (quittingOwnSingletonReward singletons coordinates) →
+        ∃ first second : Fin 4, first ≠ optional ∧ second ≠ optional ∧ first ≠ second ∧
+          quittingDirectedMembershipGap original first false
+              (quittingSingleOptionalAction optional false) < 0 ∧
+          0 < quittingDirectedMembershipGap original first false
+              (quittingSingleOptionalAction optional true) ∧
+          quittingDirectedMembershipGap original second false
+              (quittingSingleOptionalAction optional true) < 0 ∧
+          0 < quittingDirectedMembershipGap original second false
+              (quittingSingleOptionalAction optional false) ∧
+          quittingDirectedMembershipGap
+              (quittingOwnSingletonReward singletons coordinates) first false
+              (quittingSingleOptionalAction optional false) < 0 ∧
+          0 < quittingDirectedMembershipGap
+              (quittingOwnSingletonReward singletons coordinates) first false
+              (quittingSingleOptionalAction optional true) ∧
+          quittingDirectedMembershipGap
+              (quittingOwnSingletonReward singletons coordinates) second false
+              (quittingSingleOptionalAction optional true) < 0 ∧
+          0 < quittingDirectedMembershipGap
+              (quittingOwnSingletonReward singletons coordinates) second false
+              (quittingSingleOptionalAction optional false) := by
