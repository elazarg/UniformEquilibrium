+/-- Internally select one rational coordinate point in any nonempty open region.
+The SAME point excludes positive tied complete debts for EVERY singleton
+vector and EVERY screened root, including optional endpoints and extra sure players. -/
+theorem exists_rational_screenedRootCoordinates_mem_open
+    {region : Set (QuittingFreeRewardCoordinate (Fin 4) → ℝ)}
+    (hopen : IsOpen region) (hnonempty : region.Nonempty) :
+    ∃ rational : QuittingFreeRewardCoordinate (Fin 4) → ℚ,
+      (fun axis => (rational axis : ℝ)) ∈ region ∧
+      screenedRootPolynomialEval (fun axis => (rational axis : ℝ))
+        screenedRootExclusionPolynomial ≠ 0 ∧
+      ∀ (singletons : Fin 4 → ℝ) (root : Fin 4 → PMF Bool),
+        IsScreenedQuittingRoot root →
+          ¬ ∃ debt : ℝ, 0 < debt ∧ ∀ who,
+            quittingTerminalDeviationDebt
+              (quittingOwnSingletonReward singletons (fun axis => (rational axis : ℝ)))
+              (quittingOneDateThenNeverProfile
+                (quittingOwnSingletonReward singletons (fun axis => (rational axis : ℝ))) root)
+              who = debt := by
+  obtain ⟨rational, hregion, hvalue⟩ :=
+    Math.exists_rational_mem_open_eval_ne_zero_mvPolynomial
+      (MvPolynomial.map (Int.castRingHom ℝ) screenedRootExclusionPolynomial)
+      screenedRootExclusionPolynomial_map_real_ne_zero hopen hnonempty
+  have hnonzero : screenedRootPolynomialEval (fun axis => (rational axis : ℝ))
+      screenedRootExclusionPolynomial ≠ 0 := by
+    simpa only [screenedRootPolynomialEval_eq_real_eval] using hvalue
+  refine ⟨rational, hregion, hnonzero, ?_⟩
+  intro singletons root hscreened
+  exact not_positive_equal_screened_debts_of_polynomial_ne_zero
+    (fun axis => (rational axis : ℝ)) hnonzero singletons root hscreened
