+theorem exists_rational_interior_screenedRootCoordinates_near
+    (coordinates : QuittingFreeRewardCoordinate (Fin 4) → ℝ) (radius : ℝ)
+    (hbound : ∀ axis, |coordinates axis| ≤ 1) (hradius : 0 < radius) :
+    ∃ rational : QuittingFreeRewardCoordinate (Fin 4) → ℚ,
+      (∀ axis, |(rational axis : ℝ)| < 1 ∧
+        |(rational axis : ℝ) - coordinates axis| < radius) ∧
+      screenedRootPolynomialEval (fun axis => (rational axis : ℝ))
+        screenedRootExclusionPolynomial ≠ 0 ∧
+      ∀ (singletons : Fin 4 → ℝ), (∀ who, |singletons who| ≤ 1) →
+        ∀ (root : Fin 4 → PMF Bool), IsScreenedQuittingRoot root →
+          ¬ ∃ debt : ℝ, 0 < debt ∧ ∀ who,
+            quittingTerminalDeviationDebt
+              (quittingOwnSingletonReward singletons (fun axis => (rational axis : ℝ)))
+              (quittingOneDateThenNeverProfile
+                (quittingOwnSingletonReward singletons (fun axis => (rational axis : ℝ))) root)
+              who = debt := by
+  obtain ⟨rational, hbox, hvalue⟩ :=
+    Math.exists_rational_box_eval_ne_zero_mvPolynomial
+      (MvPolynomial.map (Int.castRingHom ℝ) screenedRootExclusionPolynomial)
+      screenedRootExclusionPolynomial_map_real_ne_zero
+      (fun _ => -1) (fun _ => 1) coordinates radius
+      (fun _ => by norm_num) (fun axis => abs_le.mp (hbound axis)) hradius
+  have hnonzero : screenedRootPolynomialEval (fun axis => (rational axis : ℝ))
+      screenedRootExclusionPolynomial ≠ 0 := by
+    simpa only [screenedRootPolynomialEval_eq_real_eval] using hvalue
+  refine ⟨rational, ?_, hnonzero, ?_⟩
+  · intro axis
+    exact ⟨abs_lt.mpr ⟨(hbox axis).1, (hbox axis).2.1⟩, (hbox axis).2.2⟩
+  · intro singletons _ root hscreened
+    exact not_positive_equal_screened_debts_of_polynomial_ne_zero
+      (fun axis => (rational axis : ℝ)) hnonzero singletons root hscreened
