+      screenedRootPolynomialEval coordinates screenedRootExclusionPolynomial ≠ 0} := by
+  simpa only [screenedRootPolynomialEval_eq_real_eval] using
+    Math.isOpen_eval_ne_zero_mvPolynomial
+      (MvPolynomial.map (Int.castRingHom ℝ) screenedRootExclusionPolynomial)
