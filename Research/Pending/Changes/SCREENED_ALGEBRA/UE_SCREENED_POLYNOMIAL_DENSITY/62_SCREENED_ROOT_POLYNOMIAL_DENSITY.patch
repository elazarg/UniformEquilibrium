+/-- Real-coefficient evaluation is the existing literal integer-polynomial evaluator. -/
+theorem screenedRootPolynomialEval_eq_real_eval
+    (coordinates : QuittingFreeRewardCoordinate (Fin 4) → ℝ) :
+    screenedRootPolynomialEval coordinates screenedRootExclusionPolynomial =
+      MvPolynomial.eval coordinates
+        (MvPolynomial.map (Int.castRingHom ℝ) screenedRootExclusionPolynomial) := by
+  change MvPolynomial.eval₂ (Int.castRingHom ℝ) coordinates
+      screenedRootExclusionPolynomial = _
+  exact (MvPolynomial.eval_map _ _ _).symm
+
+/-- The genuine actual polynomial's nonvanishing locus is open. -/
+theorem screenedRootExclusionPolynomial_nonvanishing_isOpen :
