+              (quittingOwnSingletonReward otherSingletons
+                (fun coordinate => (coordinates coordinate : ℝ))) profile ≤
+            quittingTerminalExploitabilityInf
+              (quittingOwnSingletonReward otherSingletons
+                (fun coordinate => (coordinates coordinate : ℝ))) + radius →
