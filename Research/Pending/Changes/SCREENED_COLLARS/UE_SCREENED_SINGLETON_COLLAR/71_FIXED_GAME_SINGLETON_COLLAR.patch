+import Mathlib.Topology.Order.Compact
+import Mathlib.Tactic.Linarith
+import Mathlib.Tactic.NormNum
+
+/-! # A uniform positive collar near a compact zero fiber -/
+
+namespace Math
+
+open Set
+
+/-- Positive mass on every zero of a nonnegative continuous objective on a
+compact carrier gives one positive mass floor in one objective neighborhood.
+Both extrema are produced internally; no favorable minimizer is supplied. -/
+theorem exists_positive_near_zero_collar_of_compact
+    {X : Type*} [TopologicalSpace X] (carrier : Set X)
+    (objective mass : X → ℝ)
+    (hcompact : IsCompact carrier) (hobjective : Continuous objective)
+    (hmass : Continuous mass)
+    (hzero : ∃ point ∈ carrier, objective point = 0)
+    (hnonneg : ∀ point ∈ carrier, 0 ≤ objective point)
+    (hpositive : ∀ point ∈ carrier, objective point = 0 → 0 < mass point) :
+    ∃ (floor radius : ℝ), 0 < floor ∧ 0 < radius ∧
+      ∀ point ∈ carrier, objective point ≤ radius → floor ≤ mass point := by
+  let zeros := carrier ∩ {point | objective point = 0}
+  have hzerosCompact : IsCompact zeros :=
+    hcompact.inter_right (isClosed_eq hobjective continuous_const)
+  have hzerosNonempty : zeros.Nonempty := by
+    obtain ⟨point, hpoint, hvalue⟩ := hzero
+    exact ⟨point, hpoint, hvalue⟩
+  obtain ⟨minimum, hminimum, hmassMinimum⟩ :=
+    hzerosCompact.exists_isMinOn hzerosNonempty hmass.continuousOn
+  have hminimumPositive : 0 < mass minimum :=
+    hpositive minimum hminimum.1 hminimum.2
+  let bad := carrier ∩ {point | mass point ≤ mass minimum / 2}
+  have hbadCompact : IsCompact bad :=
+    hcompact.inter_right (isClosed_le hmass continuous_const)
+  by_cases hbad : bad.Nonempty
+  · obtain ⟨boundary, hboundary, hobjectiveMinimum⟩ :=
+      hbadCompact.exists_isMinOn hbad hobjective.continuousOn
+    have hboundaryPositive : 0 < objective boundary := by
+      by_contra hnot
+      have hvalue : objective boundary = 0 :=
+        le_antisymm (not_lt.mp hnot) (hnonneg boundary hboundary.1)
+      have hmassLe := hmassMinimum (show boundary ∈ zeros from ⟨hboundary.1, hvalue⟩)
+      have hbadLe := hboundary.2
+      linarith
+    refine ⟨mass minimum / 2, objective boundary / 2, by linarith, by linarith, ?_⟩
+    intro point hpoint hnear
+    by_contra hnot
+    have hbadPoint : point ∈ bad := ⟨hpoint, (not_le.mp hnot).le⟩
+    have hfloor := hobjectiveMinimum hbadPoint
+    linarith
+  · refine ⟨mass minimum / 2, 1, by linarith, by norm_num, ?_⟩
+    intro point hpoint _hnear
+    by_contra hnot
+    exact hbad ⟨point, hpoint, (not_le.mp hnot).le⟩
+
+end Math
