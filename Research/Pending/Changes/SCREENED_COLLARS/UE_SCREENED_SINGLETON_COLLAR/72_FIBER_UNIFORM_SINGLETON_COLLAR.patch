+    (hcoordinates : ∀ coordinate, |coordinates coordinate| ≤ 1) :
+    IsCompact (screenedPositiveSingletonFiberJointCarrier coordinates threshold) := by
+  let ambient := Set.Icc (-1 : Fin 4 → ℝ) 1 ×ˢ
+    (quittingTerminalSemanticBox (Fin 4) 1 ×ˢ
+      Math.Probability.simplexWeights (QuittingTerminalOutcome (Fin 4)))
+  have hcompact : IsCompact ambient := isCompact_Icc.prod
+    ((quittingTerminalSemanticBox_isCompact (ι := Fin 4) 1).prod
+      (Math.Probability.isCompact_simplexWeights (QuittingTerminalOutcome (Fin 4))))
+  have hmap : Continuous (fun point : (Fin 4 → ℝ) ×
+      QuittingTerminalSemanticLawPoint (Fin 4) =>
+      (quittingOwnSingletonReward point.1 coordinates, point.2)) :=
+    ((continuous_quittingOwnSingletonReward_singletons coordinates).comp continuous_fst).prodMk
+      continuous_snd
+  have hboundClosed : IsClosed
+      {point : (Fin 4 → ℝ) × QuittingTerminalSemanticLawPoint (Fin 4) |
+        ∀ who, |point.1 who| ≤ 1} :=
+    isClosed_iInter (fun who => isClosed_le
+      ((continuous_apply who |>.comp continuous_fst).abs) continuous_const)
+  have hthresholdClosed : IsClosed
+      {point : (Fin 4 → ℝ) × QuittingTerminalSemanticLawPoint (Fin 4) |
+        threshold ≤ quittingTerminalExploitabilityInf
+          (quittingOwnSingletonReward point.1 coordinates)} :=
+    isClosed_le continuous_const
+      ((continuous_quittingTerminalExploitabilityInf_ownSingletonReward coordinates).comp
+        continuous_fst)
+  have hgraphClosed := isClosed_terminalSemanticLawCarrier_reward_graph.preimage hmap
+  apply hcompact.of_isClosed_subset
+    (hboundClosed.inter (hthresholdClosed.inter hgraphClosed))
+  rintro point ⟨hsingletons, _hthreshold, hpoint⟩
+  have hunit := (abs_quittingOwnSingletonReward_le_one_iff point.1 coordinates).mpr
+    ⟨hsingletons, hcoordinates⟩
+  refine ⟨?_, quittingTerminalSemanticCarrier_mem_box _ point.2.1 hunit
+    (terminalSemanticLawCarrier_fst_mem_carrier point.2 hpoint),
+    terminalSemanticLawCarrier_mass_mem_stdSimplex point.2 hpoint⟩
+  constructor <;> intro who
