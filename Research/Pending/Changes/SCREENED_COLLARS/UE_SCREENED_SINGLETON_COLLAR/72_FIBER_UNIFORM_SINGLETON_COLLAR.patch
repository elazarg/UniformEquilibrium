+      (quittingOwnSingletonReward singletons coordinates)
+    exact ⟨(singletons, point), ⟨hsingletons, hfloor, hpoint⟩, sub_eq_zero.mpr hvalue⟩
+  have hmassPositive : ∀ point ∈ carrier, objective point = 0 → 0 < mass point := by
+    rintro point ⟨hsingletons, hfloor, hpoint⟩ hvalue
+    have hequal := sub_eq_zero.mp hvalue
+    apply minimumTerminalSemanticLaw_singletonMass_pos_of_screenedPolynomial_ne_zero
+      coordinates point.1 hcoordinates hsingletons hpolynomial point.2 hpoint
+    · intro candidate hcandidate
+      rw [hequal]
+      exact quittingTerminalExploitabilityInf_le_semanticCarrier _ hcandidate
+    · rw [hequal]
+      exact hthreshold.trans_le hfloor
+  obtain ⟨floor, radius, hfloor, hradius, hcollar⟩ :=
+    Math.exists_positive_near_zero_collar_of_compact carrier objective mass
+      (isCompact_screenedPositiveSingletonFiberJointCarrier coordinates threshold hcoordinates)
+      ((continuous_quittingTerminalSemanticExploitability.comp
+        (continuous_fst.comp continuous_snd)).sub
+        ((continuous_quittingTerminalExploitabilityInf_ownSingletonReward coordinates).comp
+          continuous_fst))
+      (continuous_quittingTerminalLawSingletonMass.comp (continuous_snd.comp continuous_snd))
+      hzero hnonneg hmassPositive
