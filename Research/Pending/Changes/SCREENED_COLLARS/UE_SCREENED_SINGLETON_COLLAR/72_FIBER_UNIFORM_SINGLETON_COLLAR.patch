+      ∀ singletons : Fin 4 → ℝ, (∀ who, |singletons who| ≤ 1) →
+        threshold ≤ quittingTerminalExploitabilityInf
+          (quittingOwnSingletonReward singletons coordinates) →
+        ∀ profile :
+          (quittingGame (quittingOwnSingletonReward singletons coordinates)).BehaviorProfile,
+          quittingTerminalExploitability
+              (quittingOwnSingletonReward singletons coordinates) profile ≤
+              quittingTerminalExploitabilityInf
+                (quittingOwnSingletonReward singletons coordinates) + radius →
+            floor ≤ quittingTerminalLawSingletonMass
+              (quittingTerminalOutcomeMass
+                (quittingOwnSingletonReward singletons coordinates) profile) := by
+  let carrier := screenedPositiveSingletonFiberJointCarrier coordinates threshold
+  let objective := fun point : (Fin 4 → ℝ) × QuittingTerminalSemanticLawPoint (Fin 4) =>
+    quittingTerminalSemanticExploitability point.2.1 - quittingTerminalExploitabilityInf
+      (quittingOwnSingletonReward point.1 coordinates)
+  let mass := fun point : (Fin 4 → ℝ) × QuittingTerminalSemanticLawPoint (Fin 4) =>
+    quittingTerminalLawSingletonMass point.2.2
+  have hnonneg : ∀ point ∈ carrier, 0 ≤ objective point := by
+    rintro point ⟨_hsingletons, _hthreshold, hpoint⟩
+    exact sub_nonneg.mpr (quittingTerminalExploitabilityInf_le_semanticCarrier _
+      (terminalSemanticLawCarrier_fst_mem_carrier point.2 hpoint))
