+/-- Actual joint laws over the closed singleton cube at a fixed positive-gap threshold. -/
+def screenedPositiveSingletonFiberJointCarrier
+    (coordinates : QuittingFreeRewardCoordinate (Fin 4) → ℝ) (threshold : ℝ) :
+    Set ((Fin 4 → ℝ) × QuittingTerminalSemanticLawPoint (Fin 4)) :=
+  {point | (∀ who, |point.1 who| ≤ 1) ∧
+    threshold ≤ quittingTerminalExploitabilityInf
+      (quittingOwnSingletonReward point.1 coordinates) ∧
+    point.2 ∈ quittingTerminalSemanticLawCarrier
+      (quittingOwnSingletonReward point.1 coordinates)}
+
+/-- Compactness retains the same fixed free coordinates and the whole joint
+semantic/law fiber, including its singleton-cube boundary. -/
+theorem isCompact_screenedPositiveSingletonFiberJointCarrier
