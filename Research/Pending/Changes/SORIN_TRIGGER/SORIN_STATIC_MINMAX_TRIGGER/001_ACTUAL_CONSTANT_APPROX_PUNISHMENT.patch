+/-- The actual trigger's discounted payoff equals its prescribed calendar
+series for every valid rate, independently of the selected punishments. -/
+private theorem FiniteStageGame.discountedPayoff_triggerBehaviorProfile_eq_calendar
+    (G : FiniteStageGame) (path : ℕ → (∀ player, G.Action player))
+    (punishment : ℕ → ∀ culprit, G.MixedOpponentProfile culprit)
+    (rate : G.DiscountRate) (who : G.Player) :
+    G.discountedPayoff rate.1 (G.triggerBehaviorProfile path punishment) who =
+      G.kernel.discountedContinuationPayoff (1 - rate.1) path 0 who := by
+  classical
+  let : Finite G.kernel.Outcome := by
+    change Finite (∀ player, G.Action player)
+    exact Finite.of_fintype _
+  have hstage (time : ℕ) : G.repeatedGame.expectedStagePayoff
+      (G.triggerBehaviorProfile path punishment) PUnit.unit time who =
+        G.kernel.eu (path time) who := by
+    unfold FiniteStageGame.triggerBehaviorProfile
+    rw [KernelGame.RealizedActionRepeatedAdapter.expectedStagePayoff_toBehaviorProfile,
+      G.stageEU_triggerMonitoredProfile]
+    simp only [FiniteStageGame.kernel, KernelGame.eu_ofPureEU]
+  unfold FiniteStageGame.discountedPayoff StochasticGame.discountedPayoff
+    KernelGame.discountedContinuationPayoff
+  simp only [FiniteStageGame.repeatedInitial, zero_add]
+  congr 1
+  apply tsum_congr
+  intro time
+  rw [hstage]
+
+/-- Choose actual approximate minmax punishments internally, once for a
+calendar. The same behavioral profile delivers that calendar at every valid
+rate and caps every supported off-calendar stage of every full deviation. -/
+theorem exists_constantApproxPunishmentTrigger (G : FiniteStageGame)
+    (path : ℕ → (∀ player, G.Action player)) {ε : ℝ} (hε : 0 < ε) :
+    ∃ profile : G.BehaviorProfile,
+      (∀ (time : ℕ) (history : G.repeatedGame.Hist time),
+        (∀ k, (history.1 k).2 = path k) →
+        ∀ player, profile player time history = PMF.pure (path time player)) ∧
+      (∀ (who : G.Player) (deviation : G.BehaviorStrategy who)
+        (time : ℕ) (history : G.repeatedGame.Hist time),
+        history ∈ (G.repeatedGame.histDist (Function.update profile who deviation)
+          PUnit.unit time).support →
+        (¬∀ k, (history.1 k).2 = path k) →
+        G.repeatedGame.stageEUAt (Function.update profile who deviation) history who ≤
+          G.individualRationalLevel who + ε) ∧
+      ∀ (rate : G.DiscountRate) (who : G.Player),
+        G.discountedPayoff rate.1 profile who =
+          G.kernel.discountedContinuationPayoff (1 - rate.1) path 0 who := by
+  obtain ⟨punish, hpunish⟩ := G.exists_approx_punishmentOpponents hε
+  let punishment : ℕ → ∀ culprit, G.MixedOpponentProfile culprit := fun _ => punish
+  let profile := G.triggerBehaviorProfile path punishment
+  refine ⟨profile, ?_, ?_, ?_⟩
+  · intro time history hplayed player
+    dsimp only [profile, FiniteStageGame.triggerBehaviorProfile,
+      KernelGame.RealizedActionRepeatedAdapter.toBehaviorProfile,
+      KernelGame.RealizedActionRepeatedAdapter.toBehaviorStrategy]
+    exact G.triggerMonitoredProfile_of_onPath path punishment player
+      (KernelGame.RealizedActionRepeatedAdapter.actionHistory G.kernel history) hplayed
+  · intro who deviation time history hsupport hnotPath
+    obtain ⟨first, hmismatch, hbefore, hother⟩ :=
+      (G.firstMismatch_of_mem_support_trigger_update path punishment
+        who deviation time history hsupport).resolve_left hnotPath
+    have hstatus : G.publicTriggerStatus path history = some who :=
+      G.publicTriggerStatus_eq_some_of_first path who history first.isLt hmismatch
+        (fun earlier hearlier =>
+          hbefore ⟨earlier, hearlier.trans first.isLt⟩ hearlier) hother
+    exact (G.stageEUAt_update_trigger_le_bestPureReplyValue
+      path punishment who deviation history hstatus).trans (hpunish who).le
+  · intro rate who
+    exact G.discountedPayoff_triggerBehaviorProfile_eq_calendar path punishment rate who
